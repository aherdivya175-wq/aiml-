# PR7: Clustering Techniques

import pandas as pd
import matplotlib.pyplot as plt

from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.preprocessing import StandardScaler

from scipy.cluster.hierarchy import dendrogram, linkage

# Load Dataset
data = pd.read_csv("Mall_Customers.csv")

# Select Features
X = data[
    ["Annual Income (k$)", "Spending Score (1-100)"]
]

# Scaling
scaler = StandardScaler()

X = scaler.fit_transform(X)

# Elbow Method
wcss = []

for i in range(1, 11):

    model = KMeans(
        n_clusters=i,
        random_state=42,
        n_init=10
    )

    model.fit(X)

    wcss.append(model.inertia_)

plt.plot(range(1, 11), wcss, marker="o")

plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")

plt.show()

# K-Means Clustering
kmeans = KMeans(
    n_clusters=5,
    random_state=42,
    n_init=10
)

data["KMeans"] = kmeans.fit_predict(X)

print("K-Means Clusters:")
print(data["KMeans"].value_counts().sort_index())

plt.scatter(X[:, 0], X[:, 1], c=data["KMeans"])

plt.title("K-Means Clustering")

plt.show()

# Dendrogram
d = linkage(X, method="ward")

dendrogram(d)

plt.title("Dendrogram")

plt.show()

# Hierarchical Clustering
hc = AgglomerativeClustering(n_clusters=5)

data["Hierarchical"] = hc.fit_predict(X)

print("Hierarchical Clusters:")
print(data["Hierarchical"].value_counts().sort_index())

plt.scatter(X[:, 0], X[:, 1], c=data["Hierarchical"])

plt.title("Hierarchical Clustering")

plt.show()

print("Clustering Completed Successfully!")
